{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canvo.dev/shared/actions.schema.json",
  "title": "Canvo client↔service contract",
  "definitions": {
    "Shape": {
      "type": "object",
      "required": ["id", "type", "x", "y"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "description": "geo | arrow | container | frame | text | ..." },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number", "default": 0 },
        "h": { "type": "number", "default": 0 },
        "text": { "type": ["string", "null"] },
        "from_id": { "type": ["string", "null"], "description": "arrow source shape id (e.g. ERD relation)" },
        "to_id": { "type": ["string", "null"], "description": "arrow target shape id" },
        "kind": { "type": ["string", "null"], "description": "semantic kind, OPEN set (ADR-013): service | datastore | decision | client | external | queue | start | end | note | ... — unknown kinds fall back to a plain box" },
        "subtitle": { "type": ["string", "null"], "description": "secondary line under the label" },
        "color": { "type": ["string", "null"], "description": "tldraw color token: blue | violet | orange | green | grey | light-blue | yellow | red | ..." },
        "parent_id": { "type": ["string", "null"], "description": "id of the container this shape belongs to" },
        "icon": { "type": ["string", "null"], "description": "icon name, OPEN set: server | database | shield | monitor | cloud | key | gateway | queue | ... — unknown icons fall back to the kind's default" },
        "points": { "type": ["array", "null"], "items": { "type": "number" }, "description": "routed arrow waypoints, flat [x0,y0,x1,y1,...] in absolute coords; absent → client uses a bound elbow arrow" },
        "label_x": { "type": ["number", "null"], "description": "label chip anchor x for routed arrows" },
        "label_y": { "type": ["number", "null"], "description": "label chip anchor y for routed arrows" }
      }
    },
    "CanvasContext": {
      "type": "object",
      "properties": {
        "focused_shapes": { "type": "array", "items": { "$ref": "#/definitions/Shape" } },
        "blurry_shapes": { "type": "array", "items": { "$ref": "#/definitions/Shape" } },
        "screenshot": { "type": ["string", "null"], "description": "base64 PNG" }
      }
    },
    "LLMOverride": {
      "type": "object",
      "description": "Optional per-request BYOK override; used only for that request, never persisted.",
      "properties": {
        "provider": { "type": "string", "description": "anthropic | openrouter | openai-compatible" },
        "model": { "type": "string" },
        "api_key": { "type": "string" },
        "base_url": { "type": ["string", "null"] }
      }
    },
    "AgentInput": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": { "type": "string" },
        "session_id": { "type": "string", "default": "dev" },
        "input_kind": { "type": ["string", "null"], "description": "text | sql | openapi | code; omit to auto-detect" },
        "payload": { "type": ["string", "null"], "description": "raw input material (SQL DDL, OpenAPI doc, code)" },
        "canvas_context": { "$ref": "#/definitions/CanvasContext" },
        "llm": { "$ref": "#/definitions/LLMOverride" }
      }
    },
    "AgentAction": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["create", "update", "delete"] },
        "shape": { "$ref": "#/definitions/Shape" },
        "shape_id": { "type": ["string", "null"] }
      }
    }
  }
}
