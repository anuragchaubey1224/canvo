{
  "id": "edit-empty-diagram-refused",
  "category": "edit",
  "description": "Ops that would remove every node must be refused as a batch — the diagram on screen must survive intact, not vanish.",
  "input": {
    "base_plan": {
      "title": "Web Persistence",
      "nodes": [
        {"id": "client", "label": "Client", "kind": "client", "group": "g1"},
        {"id": "api", "label": "API Gateway", "kind": "service", "group": "g1"},
        {"id": "db", "label": "Primary Database", "group": "g2"},
        {"id": "cache", "label": "In-Memory Cache", "group": "g2"}
      ],
      "edges": [
        {"source": "client", "target": "api", "label": "request"},
        {"source": "api", "target": "db", "label": "write"},
        {"source": "api", "target": "cache", "label": "read"}
      ],
      "groups": [
        {"id": "g1", "label": "1. Edge"},
        {"id": "g2", "label": "2. Storage"}
      ]
    },
    "intent": "edit",
    "request": "delete everything",
    "ops": [
      {"op": "remove_node", "id": "client"},
      {"op": "remove_node", "id": "api"},
      {"op": "remove_node", "id": "db"},
      {"op": "remove_node", "id": "cache"}
    ]
  },
  "expect": {
    "nodes_min": 4,
    "nodes_max": 4,
    "edges_min": 3,
    "edges_max": 3,
    "must_contain": ["n-client", "n-api", "n-db", "n-cache"],
    "clean": true,
    "intent": "edit",
    "rejected_contains": "whole diagram"
  }
}
