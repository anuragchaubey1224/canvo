# Copy to `.env` and fill in. `.env` is gitignored.

# --- LLM provider (server default; users can override per-request via BYOK) ---
# provider: anthropic | openrouter | openai-compatible

# Option A — Anthropic direct:
#   LLM_PROVIDER=anthropic
#   LLM_MODEL=claude-sonnet-5
#   ANTHROPIC_API_KEY=sk-ant-...

# Option B — OpenRouter (one key, many models; OpenAI-compatible):
#   LLM_PROVIDER=openrouter
#   LLM_MODEL=anthropic/claude-sonnet-4.5     # or anthropic/claude-sonnet-4.6, etc.
#   OPENROUTER_API_KEY=sk-or-...

LLM_PROVIDER=openrouter
LLM_MODEL=google/gemini-3.7-flash
# LLM_BASE_URL=            # only for a custom OpenAI-compatible gateway

# Per-stage overrides (LLM_<ROLE>_MODEL, see app/llm.py resolve_config(role=...)).
# The Spec Writer extracts and completes a brief — no spatial reasoning — so it can run on
# a cheaper model than the planner when you want to split them. A BYOK model always wins.
LLM_SPEC_MODEL=google/gemini-3.7-flash

ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Langfuse tracing (optional in Phase 0; enable in Phase 1)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Auth ---
# Origins allowed to send the session cookie. Session cookies require an explicit
# allow-list: a browser refuses to send credentials to a wildcard origin.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secure cookies default to ON. Set false ONLY for local plain-http development —
# a browser will not send a Secure cookie over http, so login silently won't stick.
# In production the API must be same-site with the app (api.example.com), because the
# session cookie is SameSite=Lax and that is what stands in for CSRF protection.
COOKIE_SECURE=false

# --- Email (password reset + address verification) ---
# Where the links we email point — the WEB app, not this service.
APP_URL=http://localhost:5173

# console (default) prints the message to the server log instead of sending it, so the
# reset flow works locally with no provider and no secrets. Set to `resend` in production.
EMAIL_BACKEND=console
# RESEND_API_KEY=re_...
# EMAIL_FROM=Canvo <noreply@yourdomain.com>

# Persistence — SQLite by default (dev); swap to Postgres in prod, e.g.
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/canvo
DATABASE_URL=sqlite+aiosqlite:///./canvo.db

# Alembic owns the schema. The app migrates on startup, which suits a single instance.
# Running several? Set this false and run `alembic upgrade head` once as a release step,
# or two booting workers race for the same lock.
# RUN_MIGRATIONS=false

# --- Generation allowance ---
# This is a cost control, enforced server-side in /agent/stream before any model call.
#
# Per account, for the lifetime of the account. `0` disables it — that is the escape
# hatch for running a live demo, not an accident.
FREE_RUN_LIMIT=3
#
# Across everyone, resetting at midnight UTC. This is the one that actually protects the
# bill: a per-account limit is only as strong as the cost of a new account, and a new
# account costs an attacker one disposable inbox. `0` disables it.
DAILY_RUN_LIMIT=60
#
# To clear one account's allowance without lifting the limit for everyone:
#   python -m app.scripts.reset_quota you@example.com

# --- Measurement ---
# Nothing to configure yet: token and cost accounting is always on and costs nothing
# (app/usage.py). Model prices live in that file's PRICES table — update it when you
# change LLM_MODEL, or the cost figure silently becomes a lower bound.
