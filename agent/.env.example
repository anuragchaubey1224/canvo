# Copy to `.env` and fill in. `.env` is gitignored.

# --- LLM provider (server default; users can override per-request via BYOK) ---
# provider: anthropic | openrouter | openai-compatible
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
# LLM_BASE_URL=            # only for openrouter / custom gateways

# Anthropic (needed once the LLM nodes are wired — Phase 0 stubs run without it)
ANTHROPIC_API_KEY=

# OpenRouter (optional — one key, many models; OpenAI-compatible)
OPENROUTER_API_KEY=

# Langfuse tracing (optional in Phase 0; enable in Phase 1)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Supabase (persistence — added later)
SUPABASE_URL=
SUPABASE_KEY=
